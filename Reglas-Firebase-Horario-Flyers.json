{
  "rules": {
    "ediciones": {
      "$edicion": {
        "horariosPorImagen": {
          "$imagen": {
            ".validate": "newData.hasChild('plantilla')",
            "plantilla": {
              ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
              ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.hasChildren(['id','original','baseUrl','diaInicial','horaInicial','dia','hora','formatoDia','formatoHora'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "original": {
                ".validate": "newData.isString() && newData.val().length <= 2048"
              },
              "baseUrl": {
                ".validate": "newData.isString() && newData.val().length <= 2048"
              },
              "baseMiniaturaUrl": {
                ".validate": "newData.isString() && newData.val().length <= 2048"
              },
              "diaInicial": {
                ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^(Lunes|Martes|Miércoles|Jueves|Viernes|Sábado|Domingo)$/))"
              },
              "horaInicial": {
                ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))"
              },
              "dia": {
                ".validate": "newData.hasChildren(['x','y','fuente','peso','color','tamano','ancho'])",
                "alineacion": {
                  ".validate": "newData.isString() && newData.val().matches(/^(left|right|center)$/)"
                }
              },
              "hora": {
                ".validate": "newData.hasChildren(['x','y','fuente','peso','color','tamano','ancho'])",
                "alineacion": {
                  ".validate": "newData.isString() && newData.val().matches(/^(left|right|center)$/)"
                }
              },
              "formatoDia": {
                ".validate": "newData.isString() && newData.val().matches(/^(inicial|mayusculas|minusculas)$/)"
              },
              "formatoHora": {
                ".validate": "newData.isString() && newData.val().matches(/^(dosPuntos|sinCero|punto)$/)"
              },
              "$otro": {
                ".validate": false
              },
              "prefijoDia": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "sufijoHora": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              }
            },
            "$otro": {
              ".validate": false
            },
            "plantillasAnteriores": {
              ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
              "$plantilla": {
                ".validate": "newData.child('id').val() === $plantilla"
              }
            },
            "versiones": {
              "$version": {
                ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('colaboradores').child(auth.uid).val() === true) && !data.exists() && newData.exists() && data.parent().parent().parent().parent().child('rama').val() === 'flyers' && newData.child('plantillaId').val() === newData.parent().parent().child('plantilla').child('id').val()",
                ".validate": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('colaboradores').child(auth.uid).val() === true) && newData.hasChildren(['dia','hora','plantillaId']) && (newData.child('plantillaId').val() === newData.parent().parent().child('plantilla').child('id').val() || (data.exists() && newData.parent().parent().child('plantillasAnteriores').child(newData.child('plantillaId').val()).exists()))",
                "dia": {
                  ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^(Lunes|Martes|Miércoles|Jueves|Viernes|Sábado|Domingo)$/))"
                },
                "hora": {
                  ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))"
                },
                "plantillaId": {
                  ".validate": "newData.isString() && newData.val().length <= 100"
                },
                "$otro": {
                  ".validate": false
                }
              }
            }
          }
        }
      }
    }
  }
}
